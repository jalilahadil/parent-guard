rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /familyLinks/{linkId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.parentUid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.parentUid == request.auth.uid ||
        request.resource.data.childUid == request.auth.uid
      );
    }

    match /restrictions/{childUid} {
      allow read: if signedIn() && (
        request.auth.uid == childUid ||
        request.auth.token.role == 'parent'
      );
      allow write: if signedIn() && request.auth.token.role == 'parent';
    }

    match /usage/{recordId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}
